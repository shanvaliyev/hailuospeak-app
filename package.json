{
  "name": "hailuospeak-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @hailuospeak-app/db --",
    "db:studio": "turbo run db:studio -F @hailuospeak-app/db --",
    "db:generate": "turbo run db:generate -F @hailuospeak-app/db --",
    "db:migrate": "turbo run db:migrate -F @hailuospeak-app/db --",
    "db:local": "turbo run db:local -F @hailuospeak-app/db --",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/server && pnpm run auth:generate",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hailuospeak-app/config": "workspace:*",
    "@types/node": "^26.4.1",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "pnpm@11.22.0"
}
